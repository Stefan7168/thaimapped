{
  "version": 8,
  "name": "ThaiMapped Paper",
  "metadata": {
    "thaimapped:note": "Warm paper look on OpenMapTiles schema via OpenFreeMap (free, no key). Glyph URL is an assumption until the first live render confirms it; no sprite is used on purpose.",
    "thaimapped:palette": { "paper": "#f6f4ee", "ink": "#2b2a26", "water": "#cfe0e6", "green": "#d9e4c8", "road": "#ffffff", "roadCasing": "#dcd6c8", "building": "#e9e2d3", "accent": "#c8553d" }
  },
  "sources": {
    "openmaptiles": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f6f4ee" } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#d9e4c8", "fill-opacity": 0.8 } },
    { "id": "landcover-green", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["wood", "grass", "farmland", "wetland"]]],
      "paint": { "fill-color": "#dfe7cf", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 0.8] } },
    { "id": "landuse-built", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["residential", "suburb", "neighbourhood", "commercial", "industrial", "retail"]]],
      "paint": { "fill-color": "#efebe1", "fill-opacity": 0.6 } },
    { "id": "landuse-civic", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["hospital", "school", "college", "university", "stadium", "cemetery", "railway"]]],
      "paint": { "fill-color": "#e8e3d6", "fill-opacity": 0.7 } },
    { "id": "aeroway-area", "type": "fill", "source": "openmaptiles", "source-layer": "aeroway",
      "filter": ["==", ["geometry-type"], "Polygon"], "paint": { "fill-color": "#e6e1d5" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": { "line-color": "#c2d6dd", "line-width": ["interpolate", ["exponential", 1.3], ["zoom"], 9, 0.5, 18, 6] } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"], "paint": { "fill-color": "#cfe0e6" } },
    { "id": "water-shade", "type": "line", "source": "openmaptiles", "source-layer": "water",
      "paint": { "line-color": "#b3c9d1", "line-width": 0.6, "line-opacity": 0.6 } },
    { "id": "building-2d", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13,
      "paint": { "fill-color": "#e9e2d3", "fill-outline-color": "#d8cfbd",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14.5, 0.9] } },
    { "id": "aeroway-line", "type": "line", "source": "openmaptiles", "source-layer": "aeroway",
      "filter": ["==", ["geometry-type"], "LineString"],
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 11, 1, 17, 20] } },
    { "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["all", ["==", ["get", "class"], "rail"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": { "line-color": "#c9c2b3", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 12, 0.6, 18, 3], "line-dasharray": [3, 2] } },
    { "id": "transit-line", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "transit"],
      "paint": { "line-color": "#c8553d", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 10, 1, 16, 4], "line-opacity": 0.75 } },
    { "id": "road-minor-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 13,
      "filter": ["all", ["in", ["get", "class"], ["literal", ["minor", "service", "track", "path"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#dcd6c8", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 13, 1.2, 18, 10] } },
    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 13,
      "filter": ["all", ["in", ["get", "class"], ["literal", ["minor", "service", "track", "path"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 13, 0.6, 18, 8] } },
    { "id": "road-mid-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 10,
      "filter": ["all", ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#d6cfbf", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 10, 1, 18, 16] } },
    { "id": "road-mid", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 10,
      "filter": ["all", ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 10, 0.5, 18, 13] } },
    { "id": "road-major-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 7,
      "filter": ["all", ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#d0c8b5", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 7, 1, 18, 22] } },
    { "id": "road-major", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 7,
      "filter": ["all", ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#fbf7ea", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 7, 0.6, 18, 18] } },
    { "id": "boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 2], ["!=", ["get", "maritime"], 1]],
      "paint": { "line-color": "#b5ad9c", "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.8, 10, 2], "line-dasharray": [4, 2] } },
    { "id": "boundary-province", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "minzoom": 6,
      "filter": ["==", ["get", "admin_level"], 4],
      "paint": { "line-color": "#c6bfae", "line-width": 0.8, "line-dasharray": [2, 2], "line-opacity": 0.7 } },
    { "id": "label-water", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name",
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Italic"], "text-size": 12, "symbol-placement": "line" },
      "paint": { "text-color": "#7d9aa4", "text-halo-color": "#cfe0e6", "text-halo-width": 1 } },
    { "id": "label-road", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 14,
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"]]],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 11, "symbol-placement": "line", "text-letter-spacing": 0.03 },
      "paint": { "text-color": "#6f6a5f", "text-halo-color": "#ffffff", "text-halo-width": 1.2 } },
    { "id": "label-transit", "type": "symbol", "source": "openmaptiles", "source-layer": "poi", "minzoom": 12,
      "filter": ["all", ["==", ["get", "class"], "railway"], ["==", ["get", "subclass"], "station"]],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Bold"], "text-size": 11, "text-anchor": "top", "text-offset": [0, 0.4] },
      "paint": { "text-color": "#c8553d", "text-halo-color": "#f6f4ee", "text-halo-width": 1.4 } },
    { "id": "label-place-minor", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 11,
      "filter": ["in", ["get", "class"], ["literal", ["suburb", "neighbourhood", "quarter", "village"]]],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 12, "text-transform": "uppercase", "text-letter-spacing": 0.12 },
      "paint": { "text-color": "#8a8374", "text-halo-color": "#f6f4ee", "text-halo-width": 1.4 } },
    { "id": "label-place-city", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town"]]],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Bold"], "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 12, 18] },
      "paint": { "text-color": "#2b2a26", "text-halo-color": "#f6f4ee", "text-halo-width": 1.6 } },
    { "id": "label-country", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "maxzoom": 7,
      "filter": ["==", ["get", "class"], "country"],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Bold"], "text-size": 14, "text-transform": "uppercase", "text-letter-spacing": 0.2 },
      "paint": { "text-color": "#5e584c", "text-halo-color": "#f6f4ee", "text-halo-width": 1.6 } }
  ]
}
