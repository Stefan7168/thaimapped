# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# maplibre worker copied by scripts/copy-maplibre-worker.mjs
/public/vendor

# taste-skill working files: keep the dealt direction, not the inspector's screenshots
.taste-skill/*
!.taste-skill/direction.json

# Claude Code: personal, machine-local files. settings.local.json can hold
# approved shell commands with secrets in them, so never commit it.
# Shared team config (.claude/settings.json, .claude/skills/) stays tracked.
.claude/settings.local.json
.claude/**/*.local.json
CLAUDE.local.md
.claude/todos/
.claude/shell-snapshots/
