{
  "id": "silom",
  "city": "bangkok",
  "name": {
    "en": "Silom and Sathorn"
  },
  "tagline": {
    "en": "Office district by day, Patpong and rooftop bars by night."
  },
  "about": {
    "en": "Silom and Sathorn are the office district, so the streets are busy on weekdays and quiet at weekends. Sala Daeng (BTS S2) and Silom (MRT) are the stations; Lumphini Park is at the top of the road, Patpong night market and the bars are just below, and the rooftop bars on the Mahanakhon tower and the Sathorn hotels are the evening draw. Good for business travellers and anyone who wants a park run in the morning."
  },
