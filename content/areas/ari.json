{
  "id": "ari",
  "city": "bangkok",
  "name": {
    "en": "Ari"
  },
  "tagline": {
    "en": "A local neighbourhood with cafes and quiet lanes. Where expats send friends."
  },
  "about": {
    "en": "Ari (BTS N5) is a residential neighbourhood on the Sukhumvit line north of the centre, with small cafes, bakeries and restaurants in the lanes off Phahon Yothin Road. It is where longer-term residents send friends who want to see everyday Bangkok. Saphan Khwai, one stop south, is more local and leads on to Chatuchak Weekend Market at Mo Chit. Few sights, short walks, and an easy train ride into the centre."
  },
