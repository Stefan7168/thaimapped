{
  "$id": "https://thaimapped.com/schema/area.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "city": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "$ref": "common.schema.json#/$defs/localized" },
    "tagline": { "$ref": "common.schema.json#/$defs/localized" },
    "fits": { "type": "array", "items": { "enum": ["first-time", "nightlife", "food", "shopping", "business", "romantic", "quiet", "luxury", "culture", "backpacker", "local", "family"] }, "minItems": 1 },
    "color": { "type": "string", "pattern": "^area-[1-8]$" },
    "camera": { "$ref": "common.schema.json#/$defs/camera" },
    "polygon": { "type": "string" },
    "stations": { "type": "array", "items": { "type": "string" } },
    "video": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "platform": { "enum": ["instagram", "youtube", "tiktok"] },
            "url": { "type": "string", "format": "uri" },
            "creator": { "type": "string" },
            "thumb": { "type": "string" }
          },
          "required": ["platform", "url", "creator", "thumb"],
          "additionalProperties": false
        }
      ]
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/slug" },
          "kind": { "enum": ["hotel", "sight", "food", "market", "nightlife", "transport"] },
          "tier": { "enum": ["budget", "mid", "luxury"] },
          "name": { "$ref": "common.schema.json#/$defs/localized" },
          "why": { "$ref": "common.schema.json#/$defs/localized" },
          "location": {
            "type": "object",
            "properties": { "lon": { "type": "number" }, "lat": { "type": "number" } },
            "required": ["lon", "lat"],
            "additionalProperties": false
          },
          "walk": {
            "type": "object",
            "properties": { "station": { "type": "string" }, "minutes": { "type": "integer", "minimum": 1, "maximum": 30 } },
            "required": ["station", "minutes"],
            "additionalProperties": false
          },
          "links": {
            "type": "object",
            "description": "Plain destination URLs. The link builder adds the affiliate wrapper and sub-ID at render time; never store wrapped URLs here.",
            "properties": { "agoda": { "type": "string", "format": "uri" }, "booking": { "type": "string", "format": "uri" }, "viator": { "type": "string", "format": "uri" }, "klook": { "type": "string", "format": "uri" }, "official": { "type": "string", "format": "uri" } },
            "additionalProperties": false
          }
        },
        "required": ["id", "kind", "name", "why", "location", "links"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "city", "name", "tagline", "fits", "color", "camera", "stations", "video", "pins"],
  "additionalProperties": false
}
